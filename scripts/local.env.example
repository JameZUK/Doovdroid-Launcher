# Copy to scripts/local.env (git-ignored) and fill in. All optional: with nothing set, the scripts
# use adb on this computer and the only phone attached.

# adb serial of the phone (`adb devices -l`), if more than one device is attached.
DOOV_SERIAL=

# The phone is plugged into another computer: run adb there over SSH.
DOOV_SSH=
DOOV_SSH_CONFIG=

# Build without network access once Gradle's cache is filled.
DOOV_GRADLE_ARGS=
